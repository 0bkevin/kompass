# Node 24+. Datos persistentes: SQLite, archivos privados y clave de cifrado.
PORT=3001
DATA_DIR=./data

# Descubrimiento continuo mientras el servidor esté activo. Mínimo: 10 minutos.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MS=1800000

# Opcional. El radar y los borradores locales funcionan sin API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opcional. Habilita Examinar video para videos accesibles en referencias.
# También se puede configurar una clave por marca desde Ajustes.
# GEMINI_API_KEY=
# Modelo predeterminado: gemini-3.8-flash. El uso de la API puede tener costo.
# GEMINI_MODEL=gemini-3.8-flash

# Opcionales para fuentes sociales; también se guardan por marca en Ajustes.
# YouTube Data API: una búsqueda por fuente y actualización; consulta su cuota.
# YOUTUBE_API_KEY=
# Apify: Instagram Reels y TikTok; hasta USD 1 de cobro por ejecución.
# APIFY_API_TOKEN=

# Solo al desplegar detrás de un proxy HTTPS de confianza:
# TRUST_PROXY=1
# COOKIE_SECURE=true
# TRUSTED_ORIGINS=https://radar.tudominio.com
