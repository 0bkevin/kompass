# Node 24+. Datos persistentes: SQLite, archivos privados y clave de cifrado.
PORT=3001
DATA_DIR=./data

# Acceso con Google (opcional). Solo servidor; nunca variables VITE_ ni repositorio.
# Cliente OAuth de tipo Aplicación web, con el URI exacto autorizado en Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Producción: https://radar.tudominio.com/api/auth/google/callback
# Desarrollo: http://localhost:5173/api/auth/google/callback (vía proxy Vite).
GOOGLE_REDIRECT_URI=

# Descubrimiento continuo mientras el servidor esté activo. Mínimo: 10 minutos.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MS=1800000

# Configuración de plataforma: las empresas heredan la IA sin introducir claves.
# El radar y los borradores locales funcionan también sin API key.
# Proveedores IA, webs/feeds adicionales y webhooks requieren revisión del operador.
# Archivo JSON de permisos (ausente o vacío = acceso no revisado bloqueado).
# Ver docs/compliance/README.md. Una entrada no sustituye permiso real.
# SOURCE_ACCESS_POLICY_FILE=/ruta/privada/source-access-policy.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Verificar antes del despliegue: npm run integrations:check -- --require-ai

# El análisis de video está bloqueado hasta revisar derechos y tratamiento.
# También se puede configurar una clave por marca desde Ajustes.
# GEMINI_API_KEY=
# Modelo predeterminado: gemini-3.8-flash. El uso de la API puede tener costo.
# GEMINI_MODEL=gemini-3.8-flash

# Adaptadores conservados para futura integración revisada; actualmente bloqueados.
# Las credenciales no habilitan YouTube, Apify ni Gemini por sí solas.
# YOUTUBE_API_KEY=
# Apify Instagram/TikTok: no se ejecutan Actors en este despliegue.
# APIFY_API_TOKEN=

# Solo al desplegar detrás de un proxy HTTPS de confianza:
# TRUST_PROXY=1
# COOKIE_SECURE=true
# TRUSTED_ORIGINS=https://radar.tudominio.com

# Optional development ports. Vite reads the same .env file as the API.
WEB_PORT=5173
RADAR_API_PORT=3001

# Conservative Apify reservations across brands sharing a credential.
# No paid connector starts until configured and enabled. Zero pauses it.
APIFY_DAILY_BUDGET_USD=3
APIFY_MONTHLY_BUDGET_USD=30
