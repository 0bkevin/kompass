  "narrative": {
    "northStar": "The Guided Green Workspace",
    "overview": "The established 30X Radar identity pairs dark green navigation with a light neutral working surface. It feels practical, composed and readable: familiar forms, lists and disclosures support sustained editorial work. This records the incumbent application's visual language and its completed extensions.\n\nHierarchy comes from typography, space and restrained green emphasis. The workspace shows a clear action before supporting detail, while evidence remains readable in expanded sections. The interface uses Lucide outline controls and functional UI rather than illustration or simulated materials.",
    "keyCharacteristics": [
      "Dark green orientation beside light working surfaces.",
      "Manrope headings with DM Sans controls and reading text.",
      "Flat lists, soft bordered forms and restrained tonal emphasis.",
      "Visible focus and responsive stacking."
    ],
    "rules": [
      {
        "name": "The Action Emphasis Rule",
        "body": "Use filled green to identify primary actions; keep supporting actions white or transparent.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep Manrope for headings and DM Sans for body text and controls.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tone and dividers for routine hierarchy; reserve strong elevation for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** retain the dark green shell and light working surface when extending the app.",
      "**Do** reuse the shared button, field and badge components before introducing a local variant.",
      "**Do** give keyboard focus a visible offset outline and preserve reduced-motion behavior.",
      "**Do** use divided rows and disclosures for dense evidence and supporting detail.",
      "**Do** keep responsive overflow inside tables and wrap long content within its region."
    ],
    "donts": [
      "**Don't** replace the established font pair or green identity for an individual feature.",
      "**Don't** apply modal-strength shadows to routine forms and lists.",
      "**Don't** rely on placeholder text or color alone to explain a field or state.",
      "**Don't** promote incidental legacy type sizes, color variants or decorative labels into new system roles."
    ]
  }
